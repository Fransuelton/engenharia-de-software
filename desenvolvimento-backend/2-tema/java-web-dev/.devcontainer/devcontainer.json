{
  "name": "Java Web Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-arm64",
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "forwardPorts": [8080, 4848, 8081],
  "remoteUser": "root"
}
